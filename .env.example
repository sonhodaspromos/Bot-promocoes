# =====================================================================
# Bot de Ofertas · variáveis de ambiente
# Copie para ".env" SÓ no seu computador (o .env está no .gitignore).
# Em produção, cadastre os mesmos nomes em GitHub > Settings > Secrets and variables > Actions.
# NUNCA coloque valores reais neste arquivo de exemplo.
# =====================================================================

# --- Obrigatórias -------------------------------------------------------
# URL do projeto Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA (sb_secret_...). Nunca use a chave pública aqui, e nunca coloque a secreta no painel.
SUPABASE_SERVICE_KEY=

# --- Integrações (opcionais) --------------------------------------------
# Sem estas variáveis, a integração fica em MODO DEMONSTRAÇÃO.
# Também podem ser cadastradas pelo painel (ficam cifradas no Supabase Vault).

# Shopee Afiliados (Open API): painel de afiliado > Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Telegram: token do @BotFather e @usuario do canal (o bot precisa ser admin do canal)
TELEGRAM_TOKEN=
TELEGRAM_CANAL=

# Instagram (conta profissional) + ImgBB (hospedagem obrigatória das imagens)
IG_TOKEN=
IG_USER_ID=
IMGBB_KEY=

# --- Opções -------------------------------------------------------------
# MODO_DEMO=sim força demonstração em tudo, mesmo com credenciais (bom para testar)
MODO_DEMO=
# Tempo máximo de cada chamada externa, em segundos
TIMEOUT_HTTP=20
